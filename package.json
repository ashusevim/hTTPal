{
  "name": "httpal",
  "version": "1.0.0",
  "description": "A lightweight and easy-to-use command-line HTTP client for making requests and inspecting responses.",
  "main": "dist/index.js",
  "bin": {
    "httpal": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "http",
    "cli",
    "request",
    "fetch",
    "curl",
    "api",
    "rest"
  ],
  "author": "Ashish",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
